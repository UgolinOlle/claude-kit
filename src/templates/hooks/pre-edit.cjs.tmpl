#!/usr/bin/env node
// Generated by claude-kit. PreToolUse guardrail for Edit / Write / NotebookEdit.
// Blocks edits to protected paths (lockfiles, build output, secrets) and tells Claude why,
// so it changes the source of truth instead. Edit RULES freely; `claude-kit sync` merges updates.
"use strict";

const { readFileSync } = require("node:fs");
const path = require("node:path");

/** gitignore-style patterns. */
const RULES = {{rules}};

/** File names that are never blocked, even if a rule matches. */
const EXCEPTIONS = {{exceptions}};

function escape(ch) {
  return /[.+^${}()|\\]/.test(ch) ? "\\" + ch : ch;
}

function toRegExp(pattern) {
  const dirOnly = pattern.endsWith("/");
  let p = pattern.replace(/\/+$/, "");
  const anchored = p.startsWith("/") || p.includes("/");
  p = p.replace(/^\//, "");
  let re = "";
  for (let i = 0; i < p.length; i++) {
    const ch = p[i];
    if (ch === "*" && p[i + 1] === "*") {
      if (p[i + 2] === "/") {
        re += "(?:.*/)?";
        i += 2;
      } else {
        re += ".*";
        i += 1;
      }
    } else if (ch === "*") re += "[^/]*";
    else if (ch === "?") re += "[^/]";
    else if (ch === "[") {
      const end = p.indexOf("]", i);
      if (end === -1) re += "\\[";
      else {
        re += p.slice(i, end + 1);
        i = end;
      }
    } else re += escape(ch);
  }
  return new RegExp((anchored ? "^" : "(?:^|/)") + re + (dirOnly ? "/" : "(?:/|$)"));
}

function main() {
  let input;
  try {
    input = JSON.parse(readFileSync(0, "utf8"));
  } catch {
    return 0; // never block on input we don't understand
  }
  const toolInput = input.tool_input || {};
  const target = toolInput.file_path || toolInput.notebook_path;
  if (typeof target !== "string" || !target) return 0;

  const root = process.env.CLAUDE_PROJECT_DIR || input.cwd || process.cwd();
  const abs = path.resolve(input.cwd || root, target);
  const rel = path.relative(root, abs).split(path.sep).join("/");
  if (!rel || rel.startsWith("..") || path.isAbsolute(rel)) return 0; // outside the project: Claude Code's own permissions apply
  if (EXCEPTIONS.includes(path.posix.basename(rel))) return 0;

  for (const rule of RULES) {
    if (toRegExp(rule.pattern).test(rel)) {
      process.stderr.write(
        `claude-kit guardrail: editing ${rel} is blocked (${rule.pattern}): ${rule.reason}. ` +
          "If this edit is really needed, ask the user to make it or to adjust .claude/hooks/pre-edit.cjs.\n",
      );
      return 2;
    }
  }
  return 0;
}

process.exit(main());
