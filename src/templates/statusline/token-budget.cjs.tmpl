#!/usr/bin/env node
// Generated by claude-kit. Token-budget status line: context use, prompt-cache health, cost.
//   ctx 42% ▓▓▓▓░░░░░░ 84K/200K · cache 91% warm · $0.31 · Sonnet
// Thresholds: yellow at {{warn}}%, red at {{crit}}% (time to /compact or start fresh).
// Optional spend budget per session: export CLAUDE_KIT_BUDGET_USD=2
"use strict";

const WARN = {{warn}};
const CRIT = {{crit}};

const color = (code, s) => (process.env.NO_COLOR ? s : `\x1b[${code}m${s}\x1b[0m`);
const green = (s) => color(32, s);
const yellow = (s) => color(33, s);
const red = (s) => color(31, s);
const dim = (s) => color(2, s);

function k(n) {
  if (n >= 1e6) return `${(n / 1e6).toFixed(1).replace(/\.0$/, "")}M`;
  if (n >= 1e3) return `${Math.round(n / 1e3)}K`;
  return String(n);
}

function bar(pct, width = 10) {
  const filled = Math.max(0, Math.min(width, Math.round((pct / 100) * width)));
  return "▓".repeat(filled) + "░".repeat(width - filled);
}

/** Lets the context-guard hook use the real window size instead of guessing it from the model. */
function shareWindow(sessionId, size) {
  try {
    const file = require("node:path").join(require("node:os").tmpdir(), `claude-kit-window-${String(sessionId).replace(/[^\w-]/g, "")}.json`);
    require("node:fs").writeFileSync(file, JSON.stringify({ size }));
  } catch {
    // best effort
  }
}

function main() {
  let s = {};
  try {
    s = JSON.parse(require("node:fs").readFileSync(0, "utf8"));
  } catch {
    // render what we can
  }
  const parts = [];

  const cw = s.context_window || {};
  if (s.session_id && cw.context_window_size) shareWindow(s.session_id, cw.context_window_size);
  if (typeof cw.used_percentage === "number") {
    const pct = Math.round(cw.used_percentage);
    const tint = pct >= CRIT ? red : pct >= WARN ? yellow : green;
    const used = (cw.total_input_tokens || 0) + (cw.total_output_tokens || 0);
    const size = cw.context_window_size ? `${k(used)}/${k(cw.context_window_size)}` : "";
    let text = `ctx ${pct}% ${bar(pct)} ${size}`.trim();
    if (pct >= CRIT) text += " → /compact";
    parts.push(tint(text));
  }

  const pc = s.prompt_cache;
  if (pc && pc.caching_observed && typeof pc.hit_ratio === "number") {
    const ratio = Math.round(pc.hit_ratio * 100);
    const tint = ratio >= 80 ? green : ratio >= 50 ? yellow : red;
    parts.push(tint(`cache ${ratio}% ${pc.warm ? "warm" : "cold"}`) + (pc.misses ? dim(` (${pc.misses} miss${pc.misses === 1 ? "" : "es"})`) : ""));
  }

  const cost = s.cost && typeof s.cost.total_cost_usd === "number" ? s.cost.total_cost_usd : null;
  if (cost !== null) {
    const budget = Number(process.env.CLAUDE_KIT_BUDGET_USD) || 0;
    const text = budget ? `$${cost.toFixed(2)}/$${budget.toFixed(2)}` : `$${cost.toFixed(2)}`;
    parts.push(budget && cost >= budget ? red(text) : budget && cost >= budget * 0.8 ? yellow(text) : text);
  }

  if (s.model && s.model.display_name) parts.push(dim(s.model.display_name));
  process.stdout.write(parts.join(dim(" · ")) + "\n");
}

main();
